# Optional overrides. start-cdn.cmd already derives every path below from
# ESTERIA_CDN_ROOT, so this file only matters when the service starts by hand
# or in Docker. Keep the complete validated client tree outside Git.
CLIENT_ROOT_DIR=G:\EsteriaCDN\client
CLIENT_CHANNELS=live
LAUNCHER_UPDATES_DIR=G:\EsteriaCDN\launcher-updates
ADDONS_DIR=G:\EsteriaCDN\addons

# legacy single-channel root, still honoured when CLIENT_ROOT_DIR is unset.
# SOURCE_DIR=G:\EsteriaCDN\client\live

# optional: path to a JSON file overriding the bundled addon sources list.
# ADDONS_SOURCES_PATH=/path/to/addons-sources.json

# optional: directory holding launcher accounts, friends, chats, and avatars.
# SOCIAL_DATA_DIR=G:\EsteriaCDN\social
# optional: public origin used in avatar URLs; empty returns relative URLs.
# SOCIAL_PUBLIC_BASE_URL=https://cdn.example.com
